class Solution(object):
    def reverseParentheses(self, s):
        n = len(s)
        p = []
        pair = [0] * n
        for i in range(n):
            if s[i] == "(":
                p.append(i)
            if s[i] == ")":
                j = p.pop()
                pair[i] = j
                pair[j] = i
        result = []
        curr_index = 0
        direction = 1

        while curr_index < n:
            if s[curr_index] == "(" or s[curr_index] == ")":
                curr_index = pair[curr_index]
                direction = -direction
            else:
                result.append(s[curr_index])
            curr_index += direction

        return "".join(result)


        
