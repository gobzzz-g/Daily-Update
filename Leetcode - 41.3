class Solution:
    def minimumDeletions(self, nums: List[int]) -> int:
        if len(nums) == 1:
            return 1
        
        idx1 = nums.index(max(nums))
        idx2 = nums.index(min(nums))

        # 3 options:
        # 1. remove both from front
        # 2. remove both from back
        # 3. remove one from front and remove one from back

        # make sure idx1 < idx2 for simplifying the deletion logic
        if idx1 > idx2:
            idx1, idx2 = idx2, idx1

        op1_cost = idx2 + 1
        op2_cost = len(nums) - idx1
        op3_cost = idx1 + 1 + len(nums) - idx2

        return min(op1_cost, op2_cost, op3_cost)
