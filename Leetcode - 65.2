class Solution:
    def largestOverlap(self, img1: List[List[int]], img2: List[List[int]]) -> int:
        n = len(img1)
        ones1 = [(i, j) for i in range(n) for j in range(n) if img1[i][j]]
        ones2 = [(i, j) for i in range(n) for j in range(n) if img2[i][j]]
        
        size = 2 * n - 1
        count = [0] * (size * size)
        best = 0
        
        for x1, y1 in ones1:
            for x2, y2 in ones2:
                dx = x2 - x1 + n - 1
                dy = y2 - y1 + n - 1
                idx = dx * size + dy
                count[idx] += 1
                if count[idx] > best:
                    best = count[idx]
        
        return best
