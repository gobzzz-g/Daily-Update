class Solution:
    def generateParenthesis(self, n: int) -> list[str]:
        gen = cache(lambda k: {""} if k==0  else
            {f"({s})"    for s in gen(k-1)} |
            {f"{s1}{s2}" for i in range(1,k) for s1 in gen(i) for s2 in gen(k-i)}
        )
        return  [s for s in gen(n) if s]
        
