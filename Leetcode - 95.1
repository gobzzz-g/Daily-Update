class Solution:

    def dfs(self, grid: list[list[int]], curr_i, curr_j, rows, cols):

        if curr_i < 0 or curr_j < 0 or curr_i >= rows or curr_j >= cols:
            return

        if grid[curr_i][curr_j] == 1:
            return

        grid[curr_i][curr_j] = 1

        # left
        self.dfs(grid, curr_i, curr_j - 1, rows, cols)

        # right
        self.dfs(grid, curr_i, curr_j + 1, rows, cols)

        # up

        self.dfs(grid, curr_i - 1, curr_j, rows, cols)

        # down

        self.dfs(grid, curr_i + 1, curr_j, rows, cols)

    def closedIsland(self, grid: list[list[int]]) -> int:

        rows = len(grid)
        cols = len(grid[0])

        # print(grid)

        # if it's land just use DFS to
        # make it water , set it  as 1

        # first row
        for j in range(cols):
            if grid[0][j] == 0:
                self.dfs(grid, 0, j, rows, cols)

        # first col
        for i in range(rows):
            if grid[i][0] == 0:
                self.dfs(grid, i, 0, rows, cols)

        # last row
        for j in range(cols):
            if grid[rows - 1][j] == 0:
                self.dfs(grid, rows - 1, j, rows, cols)

        # last col
        for i in range(rows):
            if grid[i][cols - 1] == 0:
                self.dfs(grid, i, cols - 1, rows, cols)

        # print("\nAfter Updating the Grid")

        # print(grid)

        # now count all the islands starting with 0
        ans = 0

        for i in range(1, rows):
            for j in range(1, cols):
                if grid[i][j] == 0:
                    ans += 1
                    self.dfs(grid, i, j, rows, cols)

        return ans
